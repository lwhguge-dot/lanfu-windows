<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OpenClaw.SetupEngine.UI.Pages.CompletePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:OpenClaw.SetupEngine.UI.Controls"
    NavigationCacheMode="Disabled">

    <Grid RowDefinitions="*,Auto" Padding="48,28,48,24">

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel VerticalAlignment="Center" Spacing="12" HorizontalAlignment="Stretch"
                        MaxWidth="480" Margin="0,8">

                <Grid x:Name="SuccessIcon" Width="{x:Bind controls:OnboardingMascot.HeroSize}" Height="{x:Bind controls:OnboardingMascot.HeroSize}"
                      HorizontalAlignment="Center" Margin="0,0,0,4">
                    <controls:OnboardingMascot Mood="Celebrating" Accessory="GradCap" />
                    <Border Width="36" Height="36" CornerRadius="18"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Background="{ThemeResource SystemFillColorSuccessBrush}"
                            BorderBrush="{ThemeResource SolidBackgroundFillColorBaseBrush}" BorderThickness="3">
                        <FontIcon Glyph="&#xE73E;" FontSize="16" IsTextScaleFactorEnabled="False"
                                  Foreground="#FFFFFF"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  AutomationProperties.AccessibilityView="Raw" />
                    </Border>
                </Grid>
                <Grid x:Name="FailureIcon" Width="{x:Bind controls:OnboardingMascot.HeroSize}" Height="{x:Bind controls:OnboardingMascot.HeroSize}"
                      HorizontalAlignment="Center" Margin="0,0,0,16"
                      Visibility="Collapsed">
                    <controls:OnboardingMascot Mood="Sad" />
                    <Border Width="36" Height="36" CornerRadius="18"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Background="{ThemeResource SystemFillColorCriticalBrush}"
                            BorderBrush="{ThemeResource SolidBackgroundFillColorBaseBrush}" BorderThickness="3">
                        <FontIcon Glyph="&#xEA39;" FontSize="16" IsTextScaleFactorEnabled="False"
                                 Foreground="#FFFFFF"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 AutomationProperties.AccessibilityView="Raw" />
                    </Border>
                </Grid>
                <Grid x:Name="RestartIcon" Width="{x:Bind controls:OnboardingMascot.HeroSize}" Height="{x:Bind controls:OnboardingMascot.HeroSize}"
                      HorizontalAlignment="Center" Margin="0,0,0,16"
                      Visibility="Collapsed">
                    <controls:OnboardingMascot Mood="Thinking" />
                    <Border Width="36" Height="36" CornerRadius="18"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Background="{ThemeResource SystemFillColorCautionBrush}"
                            BorderBrush="{ThemeResource SolidBackgroundFillColorBaseBrush}" BorderThickness="3">
                        <FontIcon Glyph="&#xE72C;" FontSize="16" IsTextScaleFactorEnabled="False"
                                  Foreground="#FFFFFF"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  AutomationProperties.AccessibilityView="Raw" />
                    </Border>
                </Grid>

                <TextBlock x:Name="TitleText" Text="全部就绪！"
                           Style="{StaticResource TitleTextBlockStyle}"
                           HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />

                <TextBlock x:Name="SubtitleText" Text="LanFu 已就绪"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />

                <StackPanel x:Name="SummaryPanel" Spacing="8" Visibility="Collapsed">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="14,12">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <FontIcon Grid.Column="0" Glyph="&#xE756;" FontSize="18" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock x:Name="GatewaySummaryTitle" Text="本地网关运行中" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Name="GatewaySummaryText" Text="LanFu · 127.0.0.1:18789" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE73E;" FontSize="16" Foreground="{ThemeResource SystemFillColorSuccessBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Border x:Name="LocalAiSummaryCard"
                            AutomationProperties.AutomationId="LocalAiCompletionSummary"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="14,12"
                            Visibility="Collapsed">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <FontIcon Grid.Column="0" Glyph="&#xE950;" FontSize="18" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock x:Name="LocalAiSummaryTitle" Text="本地 AI 已安装"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Name="LocalAiSummaryDescription"
                                           AutomationProperties.LiveSetting="Polite"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE73E;" FontSize="16"
                                      Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                      VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Border x:Name="DevicePairedSummaryCard" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="14,12">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <FontIcon Grid.Column="0" Glyph="&#xE772;" FontSize="18" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="设备已配对" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="这台电脑已连接，可以使用" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE73E;" FontSize="16" Foreground="{ThemeResource SystemFillColorSuccessBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="14,12">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <FontIcon Grid.Column="0" Glyph="&#xEA18;" FontSize="18" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="能力配置已应用" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Name="CapabilitySummaryText" Text="随时可在桌面端设置中修改"
                                           TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE73E;" FontSize="16" Foreground="{ThemeResource SystemFillColorSuccessBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <TextBlock x:Name="NativeFeaturesNote" x:Uid="Onboarding_Native_FeaturesNote"
                               Visibility="Collapsed" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="节点模式连接并与网关配对后，这些 Windows 能力才可用。Windows 权限与命令批准仍然有效。" />
                </StackPanel>

                <Border x:Name="ErrorCard" CornerRadius="4" Padding="16,12,16,12"
                        Margin="0,16,0,0" Visibility="Collapsed"
                        Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="ErrorText" TextWrapping="Wrap"
                                   FontSize="13" FontFamily="Cascadia Code,Consolas,monospace"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                        <TextBlock x:Name="ServerDiagnosticsText" TextWrapping="Wrap"
                                   Visibility="Collapsed"
                                   FontSize="12" FontFamily="Cascadia Code,Consolas,monospace"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <HyperlinkButton x:Name="HelpLink"
                                         Visibility="Collapsed"
                                         Padding="0"
                                         FontSize="13" />
                        <HyperlinkButton x:Name="ViewLogLink" Content="查看完整日志 →"
                                         Click="ViewLog_Click" Padding="0"
                                         FontSize="13" />
                        <HyperlinkButton x:Name="ViewServerLogLink"
                                         Visibility="Collapsed"
                                         Click="ViewServerLog_Click" Padding="0"
                                         FontSize="13" />
                    </StackPanel>
                </Border>

                <InfoBar x:Name="NodeModeBanner"
                         IsOpen="True" IsClosable="False" Severity="Informational"
                         Title="节点模式已启用"
                         Message="网关可以使用这台电脑进行屏幕捕获、摄像头和系统命令。" />

                <Border x:Name="StartupRow"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="14,6,8,6">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="开机启动 LanFu"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource BodyTextBlockStyle}" />
                        <ToggleSwitch x:Name="StartupToggle" Grid.Column="1"
                                      OnContent="On" OffContent="关闭"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      MinWidth="0" />
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,16,0,0">
            <Button x:Name="FallbackButton" Grid.Column="0"
                    Content="使用已配置的回退方案重试"
                    Visibility="Collapsed"
                    Click="FallbackButton_Click" />
            <Button x:Name="RestartLaterButton" Grid.Column="0"
                    Content="不，我还没准备好"
                    Visibility="Collapsed"
                    Click="RestartLaterButton_Click" />
            <Button x:Name="LaunchButton" Grid.Column="2"
                    Content="打开对话"
                    HorizontalAlignment="Right" MinWidth="100"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="LaunchButton_Click" />
            <Button x:Name="RestartNowButton" Grid.Column="2"
                    Content="是，立即重启"
                    HorizontalAlignment="Right"
                    Visibility="Collapsed"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="RestartNowButton_Click" />
        </Grid>

    </Grid>
</Page>
