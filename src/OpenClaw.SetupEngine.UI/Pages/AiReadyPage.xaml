<Page x:Class="OpenClaw.SetupEngine.UI.Pages.AiReadyPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:OpenClaw.SetupEngine.UI.Controls"
      xmlns:tk="using:CommunityToolkit.WinUI.Controls">
    <Page.Resources>
        <DataTemplate x:Key="WrappedAction">
            <TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="160" Style="{StaticResource BodyTextBlockStyle}" />
        </DataTemplate>
    </Page.Resources>
    <Grid Padding="40,4,40,24" RowDefinitions="Auto,*,Auto">
        <StackPanel Spacing="4">
            <controls:OnboardingMascot x:Name="MascotHero" Mood="Celebrating" HorizontalAlignment="Center" />
            <TextBlock x:Uid="Onboarding_Ready_Heading" Text="你的 AI 已就绪"
                       Style="{StaticResource TitleTextBlockStyle}" TextAlignment="Center" TextWrapping="Wrap" />
            <TextBlock x:Uid="Onboarding_Ready_Prompt" Text="想先做点什么？"
                       Style="{StaticResource BodyTextBlockStyle}" TextAlignment="Center" TextWrapping="Wrap" />
            <TextBlock x:Name="ModelSummary" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" Margin="0,24,0,16" HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="8">
                <InfoBar x:Name="ErrorBar" IsOpen="False" IsClosable="False" Severity="Error">
                    <InfoBar.ActionButton>
                        <Button x:Name="RecoveryButton" x:Uid="Onboarding_Ready_Return" Content="返回 AI 设置"
                                Click="Return_Click" ContentTemplate="{StaticResource WrappedAction}" />
                    </InfoBar.ActionButton>
                </InfoBar>
                <StackPanel x:Name="Choices" Spacing="8">
                    <tk:SettingsCard x:Name="ChatChoice" x:Uid="Onboarding_Ready_Chat" Header="和我的智能体对话"
                                     Description="打开对话，与你的智能体聊天。" Tag="Chat" IsClickEnabled="True" Click="Choose_Click"
                                     AutomationProperties.Name="和我的智能体对话（推荐）">
                        <controls:RecommendedBadge x:Name="RecommendedBadge" />
                    </tk:SettingsCard>
                    <tk:SettingsCard x:Name="ChannelsChoice" x:Uid="Onboarding_Ready_Channels" Header="接入频道"
                                     Description="WhatsApp、Telegram 等。何时登录由你决定。" Tag="Channels" IsClickEnabled="True" Click="Choose_Click" />
                    <tk:SettingsCard x:Name="SkillsChoice" x:Uid="Onboarding_Ready_Skills" Header="浏览技能"
                                     Description="浏览智能体可用的技能。不会自动安装任何内容。" Tag="Skills" IsClickEnabled="True" Click="Choose_Click" />
                </StackPanel>
                <ProgressBar x:Name="BusyProgress" IsIndeterminate="True" Visibility="Collapsed" />
                <TextBlock x:Name="StatusText" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite" Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>
        <controls:SetupProgressIndicator x:Name="FlowProgress" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
</Page>
