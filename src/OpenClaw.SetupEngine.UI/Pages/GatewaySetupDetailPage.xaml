<Page x:Class="OpenClaw.SetupEngine.UI.Pages.GatewaySetupDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:OpenClaw.SetupEngine.UI.Controls">
    <Page.Resources>
        <DataTemplate x:Key="WrappedChoiceTemplate">
            <TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="480" Style="{StaticResource BodyTextBlockStyle}" />
        </DataTemplate>
    </Page.Resources>
    <Grid Padding="40,4,40,24" RowDefinitions="Auto,*,Auto">
        <StackPanel Spacing="4" HorizontalAlignment="Stretch">
            <controls:OnboardingMascot x:Name="MascotHero" Mood="Curious" HorizontalAlignment="Center" />
            <TextBlock x:Name="DetailTitle" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" TextAlignment="Center" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" Margin="0,24,0,16" MaxWidth="600" HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="12">
                <controls:LocalAiSetupControl x:Name="LocalAiOptions" Visibility="Collapsed" />
                <InfoBar x:Name="LocalAiReviewError" IsOpen="False" IsClosable="False" Severity="Error" />
                <controls:TailscaleSetupControl x:Name="TailscaleOptions" Visibility="Collapsed" />
                <StackPanel x:Name="NetworkingOptions" Spacing="16" Visibility="Collapsed">
                    <TextBlock x:Uid="Onboarding_V2_NetworkExplanation" TextWrapping="Wrap" Style="{StaticResource BodyTextBlockStyle}"
                               Text="本地 AI 需要 WSL 镜像网络。安装过程会更新全局 .wslconfig，并一次性停止所有正在运行的 WSL 发行版（不会删除任何发行版）。请先保存 WSL 中的工作。" />
                    <CheckBox x:Name="LocalAiNetworkingConsentCheckBox" x:Uid="Onboarding_V2_NetworkConsent"
                              ContentTemplate="{StaticResource WrappedChoiceTemplate}"
                              AutomationProperties.AutomationId="LocalAiNetworkingConsentCheckBox"
                              Content="我允许进行此项全局网络更改并一次性关闭 WSL。"
                              Checked="NetworkConsent_Changed" Unchecked="NetworkConsent_Changed" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
            <controls:SetupProgressIndicator x:Name="FlowProgress" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Button x:Uid="Onboarding_V2_Back" Content="返回" MinWidth="100" HorizontalAlignment="Left" Click="Back_Click" />
            <Button x:Name="PrimaryButton" Grid.Column="1" x:Uid="Onboarding_V2_ReturnToReview" Content="返回检查" MinWidth="100"
                    Click="Primary_Click" Style="{StaticResource AccentButtonStyle}" />
        </Grid>
    </Grid>
</Page>
